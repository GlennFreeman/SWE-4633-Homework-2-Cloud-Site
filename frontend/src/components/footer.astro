---
import { Image } from "astro:assets";
import DecayedBars from "../images/decayed_bars.png";
import Linkedin from "../images/LI-Logo.png";
import Github from "../images/GitHub_Lockup_White_Clearspace.png";
---

<footer
  class="footer sm:footer-horizontal bg-neutral text-neutral-content items-center p-4"
>
  <aside class="grid-flow-col items-center">
    <Image
      id="footer-logo"
      src={DecayedBars}
      alt="logo"
      class="max-h-8 w-auto rounded-xl"
    />
    <p>
      Copyright &copy; {new Date().getFullYear()} - All right reserved Glenn Freeman
    </p>
  </aside>
  <nav class="grid-flow-col gap-4 md:place-self-center md:justify-self-end">
    <a
      href="https://www.linkedin.com/in/glennjlfreeman/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image src={Linkedin} alt="Linkedin logo" class="max-h-6 w-auto" />
    </a>
    <a
      href="https://github.com/GlennFreeman"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image src={Github} alt="Github logo" class="max-h-6 w-auto" />
    </a>
  </nav>
</footer>
<style>
  #footer-logo {
    corner-shape: squirqle;
  }
</style>
