---
import { Image } from "astro:assets";
import DapperNib from "../images/dapper_nib.png";
---

<header class="mb-4">
  <nav class="navbar bg-radial from-accent to-accent-content shadow-2xl">
    <div class="aura aura-silver mr-4">
      <a href="/">
        <Image
          id="nav-logo"
          src={DapperNib}
          alt="Logo"
          class="max-h-10 max-w-10 rounded-4xl"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>
    <div class="ps-4">
      <a href="/" class="text-lg font-bold btn btn-ghost">Start&nbsp;Madlib</a>
    </div>
  </nav>
</header>
<style>
  #nav-logo {
    corner-shape: squircle;
  }
</style>
