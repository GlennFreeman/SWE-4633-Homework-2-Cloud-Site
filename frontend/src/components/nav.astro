---
import { Image } from "astro:assets";
import DapperNib from "../images/dapper_nib.png";
---

<header class="mb-4">
  <nav class="navbar bg-radial from-accent to-accent-content shadow-2xl">
    <div class="aura aura-silver mr-4">
      <a href="index.html">
        <Image
          id="nav-logo"
          src={DapperNib}
          alt="Logo"
          class="max-h-10 max-w-10 rounded-4xl"
        />
      </a>
    </div>
    <div class="ps-4">
      <a href="index.html" class="text-lg font-bold btn btn-ghost"
        >Glenn Freeman</a
      >
    </div>
    <div class="flex grow justify-end px-2">
      <div class="flex items-stretch">
        <a class="btn btn-ghost rounded-field">Button</a>
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-ghost rounded-field">
            Dropdown
          </div>
          <ul
            tabindex="-1"
            class="menu dropdown-content bg-base-200 rounded-box z-1 mt-4 w-52 p-2 shadow-sm"
          >
            <li><a>Item 1</a></li>
            <li><a>Item 2</a></li>
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>
<style>
  #nav-logo {
    corner-shape: squircle;
  }
</style>
