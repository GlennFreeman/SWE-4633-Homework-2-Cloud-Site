---
import BaseLayout from "../layouts/base_layout.astro";
---

<BaseLayout>
  <hgroup class="text-center mb-8">
    <h1 class="text-8xl font-black">Madlib Generator</h1>
    <h2 class="text-3xl text-neutral-400">
      When the juice runs dry and you gotta hit the eye.
    </h2>
  </hgroup>
  <form
    action="/api/submit"
    method="POST"
    class="flex justify-center flex-col m-auto py-4 border-2 border-accent rounded-4xl"
