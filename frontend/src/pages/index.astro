      <fieldset
        class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4"
      >
        <legend class="fieldset-legend">Adjectives</legend>
        <div class="join">
          <label for="adjective1" class="join-item border-info">1</label>
          <input
            id="adjective1"
            type="text"
            class="input join-item"
            placeholder="Enter Adjective"
          />
          <div class="tooltip" data-tip="Randomize">
            <button type="button" class="btn btn-neutral join-item">🔀</button>
          </div>
        </div>
        <div class="join">
          <label for="adjective2" class="join-item border-info">2</label>
