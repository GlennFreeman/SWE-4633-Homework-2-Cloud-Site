    <div class="flex gap-8 justify-center">
      <button id="random-all" type="button" class="btn btn-primary w-[20ch]"
        >Randomize All 🔀</button
      >
      <button class="btn btn-accent w-[20ch]">Submit 📥</button>
      <button id="clear-all" type="button" class="btn btn-error w-[20ch]"
