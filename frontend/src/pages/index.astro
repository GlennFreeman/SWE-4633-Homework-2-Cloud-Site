          placeholder="Enter Adjective"
        />
        <div class="tooltip" data-tip="Randomize">
          <button class="btn btn-neutral join-item">🔀</button>
        </div>
      </div>
    </fieldset>

    <fieldset
      class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4"
    >
      <legend class="fieldset-legend">Nouns</legend>
      <div class="join">
        <input type="text" class="input join-item" placeholder="Enter Noun" />
        <div class="tooltip" data-tip="Randomize">
          <button class="btn btn-neutral join-item">🔀</button>
