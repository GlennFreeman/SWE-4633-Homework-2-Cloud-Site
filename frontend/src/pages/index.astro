      >
    </div>
  </form>
</BaseLayout>
<style>
  label {
    font-family: monospace;
    font-size: 1.25rem;
    font-weight: 900;
    align-self: center;
    padding: 0.25rem 0.5rem;
  }
</style>
<script src="../scripts/pick_random.js"></script>
